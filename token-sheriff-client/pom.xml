<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss.sheriff.token</groupId>
        <artifactId>token-sheriff-parent</artifactId>
        <version>0.9.5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>token-sheriff-client</artifactId>
    <packaging>jar</packaging>
    <name>Token-Sheriff Client</name>
    <description>Framework-agnostic OIDC/OAuth client engine for Token-Sheriff. Builds on the commons transport
        base layer (shipped in token-sheriff-validation) to add the client-side flows — token retrieval,
        userinfo, revocation, introspection, end-session and PAR. Pure Java, no framework dependency.
    </description>

    <properties>
        <maven.jar.plugin.automatic.module.name>de.cuioss.sheriff.token.client</maven.jar.plugin.automatic.module.name>
        <version.dsl.json>2.0.2</version.dsl.json>
        <!-- Make this module's integration tier obey -DskipTests.

             Failsafe 3.6.0 ignores -DskipTests. On the snapshot-deploy lane (which passes -DskipTests)
             Surefire reported "Tests are skipped" while Failsafe still ran WiredFlowNegativePathIT, wrote a
             target/jacoco.exec covering almost none of the refresh path, and the refresh-path-coverage-check
             below then failed on that sparse-but-non-zero data. The gate was graded on POISONED coverage,
             not muted by absent coverage — which is why the all-zero reasoning further down still holds.

             skipITs is wired to skipTests as POM PROPERTIES, deliberately NOT inside the Failsafe
             <configuration> block. A CLI user property overrides a POM property but LOSES to plugin
             <configuration>, so the property form is the only one that keeps all three lanes correct:
               - deploy lane (-DskipTests=true): skipITs interpolates to true, Failsafe skips, no test JVM
                 starts, no jacoco.exec is written, and both jacoco checks skip on legitimately absent data,
                 exactly as token-sheriff-validation and token-sheriff-parent already do in that same run;
               - -DskipITs=true on the command line: the CLI value still wins over this property, so that
                 escape hatch stays live. It is load-bearing in this project precisely BECAUSE Failsafe
                 ignores -DskipTests — putting skipITs in <configuration> would have traded one broken
                 lever for another;
               - CI test lanes (`verify -Dmaven.compiler.release=21|25`, neither flag passed): skipTests
                 stays false, skipITs interpolates to false, WiredFlowNegativePathIT runs, gate fully
                 enforced.

             The <skipTests>false</skipTests> default is required, not decorative: without it ${skipTests}
             would not resolve, and an unresolved literal is not a boolean. Verify the resolution with
             `mvn help:effective-pom`, or by observing Failsafe's skip decision in a `clean verify
             -DskipTests` run — not by assertion. -->
        <skipTests>false</skipTests>
        <skipITs>${skipTests}</skipITs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.cuioss.sheriff.token</groupId>
                <artifactId>token-sheriff-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The client validates the tokens it retrieves, so it depends on validation, which also
             carries the commons base layer (transport, error model, events, metrics) transitively. -->
        <dependency>
            <groupId>de.cuioss.sheriff.token</groupId>
            <artifactId>token-sheriff-validation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.cuioss</groupId>
            <artifactId>cui-java-tools</artifactId>
        </dependency>
        <!-- HTTP transport primitive: the client composes cui-http HttpHandler for outbound OIDC
             back-channel calls (discovery, token, userinfo, revocation, PAR, end-session), reusing the
             same TLS/SSRF-hardened handler commons uses — it adds no new transport control of its own. -->
        <dependency>
            <groupId>de.cuioss</groupId>
            <artifactId>cui-http</artifactId>
        </dependency>
        <!-- Lombok for immutable value objects (@Value/@Builder). -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!-- DSL-JSON for secure, compile-time, native-friendly parsing of the OIDC discovery document,
             mirroring the WellKnownResult mapping in commons.transport. -->
        <dependency>
            <groupId>com.dslplatform</groupId>
            <artifactId>dsl-json</artifactId>
            <version>${version.dsl.json}</version>
        </dependency>
        <!-- JSpecify nullability annotations (transitive from validation; declared for direct use). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- Unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockWebServer harness for unit-level OIDC dispatcher tests. -->
        <dependency>
            <groupId>de.cuioss.test</groupId>
            <artifactId>cui-test-mockwebserver-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Value-object contract tests. -->
        <dependency>
            <groupId>de.cuioss.test</groupId>
            <artifactId>cui-test-value-objects</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test data generators. -->
        <dependency>
            <groupId>de.cuioss.test</groupId>
            <artifactId>cui-test-generator</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUL log assertions for LogRecord coverage. -->
        <dependency>
            <groupId>de.cuioss.test</groupId>
            <artifactId>cui-test-juli-logger</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reuse the validation OP-endpoint dispatchers and adversarial utilities (test-jar). -->
        <dependency>
            <groupId>de.cuioss.sheriff.token</groupId>
            <artifactId>token-sheriff-validation</artifactId>
            <version>${project.version}</version>
            <classifier>generators</classifier>
            <scope>test</scope>
        </dependency>
        <!-- Curated http.security attack databases (OWASP/CVE/ModSecurity corpora) for the fail-closed
             adversarial callback/step-up tests. Version is BOM-managed alongside the main cui-http jar. -->
        <dependency>
            <groupId>de.cuioss</groupId>
            <artifactId>cui-http</artifactId>
            <classifier>generators</classifier>
            <scope>test</scope>
        </dependency>
        <!-- JJWT: the validation test utilities (TestTokenHolder) sign test tokens with JJWT. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jakarta.json implementation for the validation pipeline at test runtime. -->
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit: enforce the client engine boundary (no CDI/MicroProfile/JAX-RS; client → validation only). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Run the Lombok and DSL-JSON annotation processors together. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${version.lombok}</version>
                        </path>
                        <path>
                            <groupId>com.dslplatform</groupId>
                            <artifactId>dsl-json</artifactId>
                            <version>${version.dsl.json}</version>
                        </path>
                    </annotationProcessorPaths>
                    <release>21</release>
                </configuration>
            </plugin>
            <!-- Re-attach the JaCoCo agent to the unit-test tier on the DEFAULT lane.
                 cui-java-parent configures Surefire with a literal <argLine>-Xms64m -Xmx1024m</argLine>,
                 which REPLACES rather than extends the argLine property that jacoco:prepare-agent sets at
                 initialize — so on a plain `mvn verify` the unit tests ran un-instrumented and the only
                 coverage reaching target/jacoco.exec came from the Failsafe tier (which inherits no argLine
                 override). Measured: the default lane reported BUNDLE BRANCH 0.200 while `-Pcoverage`
                 reported 0.851 over the identical tree. That made the always-active refresh-path check below
                 unsatisfiable, and it also made target/site/jacoco/jacoco.xml — published on every default
                 build — an IT-only report that silently understates coverage.
                 @{argLine} is Surefire's late-replacement syntax: it resolves after prepare-agent has run,
                 so the agent is prepended to the JVM args the parent already sets. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Xms64m -Xmx1024m</argLine>
                </configuration>
            </plugin>
            <!-- Bind Failsafe so the wired-flow integration tier (WiredFlowNegativePathIT, which uses
                 MockWebServer — no external infra) actually runs under `mvn verify`. The *IT class was
                 previously compiled but never executed because no Failsafe binding existed here.

                 Only the binding is declared here: the version comes from cui-parent-pom's
                 pluginManagement, the same source that supplies Surefire. Pinning it locally would
                 re-split the two tiers on every parent bump — the enforcer's RequireSameVersions rule
                 compares them, so a local pin makes the parent's Surefire move a build break until the
                 pin is hand-edited to match (PRs #703/#707). Inheriting keeps them in lockstep. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Exclude the DSL-JSON annotation processor's generated converters from coverage measurement.
                 The processor emits _<Type>_DslJsonConverter classes straight into target/classes with no
                 counterpart under src/main/java, so their branches measure the DSL-JSON code generator rather
                 than project code. The pattern is anchored to the processor's fixed _<Type>_DslJsonConverter
                 naming so it cannot silently swallow hand-written classes. The configuration sits at plugin
                 level so it applies to both the report and check goals inherited from the cuioss parent. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/_*_DslJsonConverter*.class</exclude>
                    </excludes>
                </configuration>
                <!-- Refresh-path coverage gate, bound to the always-active lane (NOT a profile) so it runs
                     under the CI invocation: .github/workflows/maven.yml delegates the whole Maven lane to
                     the external SHA-pinned cuioss/cuioss-organization reusable workflow, which this
                     repository cannot hand a -P flag.

                     Why element=CLASS and not BUNDLE: the module-wide BUNDLE rule inherited from
                     cui-java-parent (-Pcoverage; element=BUNDLE, COVEREDRATIO gating INSTRUCTION >= 0.80
                     AND BRANCH >= 0.80 — both floors read off cui-java-parent-1.7.2.pom lines 413-425)
                     cannot see a single-class refresh-path regression.

                     The numbers below are stated so the next reader can RE-DERIVE them rather than trust
                     them. Measured 2026-09-08 from token-sheriff-client/target/site/jacoco/jacoco.xml on
                     this branch (cui-quarkus-parent 1.7.2 / cui-java-parent 1.7.2). Bundle counters:
                       INSTRUCTION  7279 covered / 7689 total = 0.9467
                       BRANCH        590 covered /  670 total = 0.8806
                     Slack is how much COVERED code may vanish before the bundle floor is breached,
                     i.e. covered - ceil(floor x total):
                       INSTRUCTION  7279 - ceil(0.80 x 7689) = 7279 - 6152 = 1127 covered instructions
                       BRANCH        590 - ceil(0.80 x  670) =  590 -  536 =   54 covered branches
                     Re-measure both lines whenever this comment is touched; they are a snapshot, not a
                     constant, and the floors must be re-read from the parent rather than copied from here.

                     The 11 classes listed below hold 800 covered instructions and 83 covered branches
                     between them. So a TOTAL refresh-path wipeout is caught by the bundle rule on BRANCH
                     (83 > 54) and missed entirely on INSTRUCTION (800 < 1127). An earlier form of this comment justified the per-class rule by claiming a total wipeout passed the bundle
                     outright; on the measurement above that claim is half expired, and it is no longer the
                     reason this gate earns its keep.

                     The live justification is the SINGLE-CLASS case. flow.RefreshFlow alone carries 322
                     covered instructions and 35 of its 36 covered branches. 322 < 1127 and 35 < 54, so
                     deleting every test that covers RefreshFlow passes the inherited bundle gate SILENTLY
                     on BOTH limits. The blind spot is granularity, not threshold — hence a per-class rule
                     scoped to the refresh-path classes listed below.

                     Note on flow.CredentialRejectedException: it measures 4 INSTRUCTION and 0 BRANCH, so
                     its BRANCH limit cannot bind — the same all-zero reasoning used below to exclude
                     RedeemedRefreshFailure. Its INSTRUCTION limit does bind, so the entry is thin but not
                     vacuous. Only a negative control shows that; a green build never can.

                     Why the include entries are dotted FQCNs: jacoco matches an element=CLASS rule against
                     JavaNames.getQualifiedClassName(vmName), i.e. the DOTTED name (nested classes render as
                     Outer.Inner, never Outer$Inner) — not the VM/internal slash form. A misspelled entry is
                     NOT an error: BundleChecker simply never evaluates a limit for it and jacoco:check reports
                     "All coverage checks have been met." So the failure mode of an edit here is a FALSE GREEN
                     that silently recreates the blind spot this gate exists to close. When adding a
                     refresh-path class, use the dotted form and confirm the gate still fires.

                     Why RedeemedRefreshFailure is deliberately NOT in the list: it is a pure interface
                     (one abstract method, no default body, no constants, no static initializer), so
                     jacoco measures zero INSTRUCTION and zero BRANCH for it. A COVEREDRATIO limit over
                     an all-zero counter cannot bind — jacoco skips the limit rather than failing it —
                     so listing it would add a permanently vacuous entry that looks like coverage. Its
                     implementors (RedeemedResponseException, RedeemedScopeRefusalException,
                     RedeemedValidationRefusalException) ARE listed, and that is where the redemption
                     signal is actually measured.

                     Binding requirement — a green build is NOT evidence this rule fires. Because a
                     misspelled or vacuous include is silently skipped (see the FALSE GREEN note above),
                     every edit to this include list MUST be discharged by a negative control: remove or
                     disable the tests covering the newly listed class, run `mvn verify`, and confirm the
                     build turns RED naming that class with a BRANCH/INSTRUCTION violation — NOT "All
                     coverage checks have been met" — then restore the coverage and confirm green again.
                     Record both runs. Only the red run proves the entry binds.

                     Run the negative control with `clean`. target/jacoco.exec is APPENDED to across
                     invocations (each run adds a sessioninfo), so a `verify` without `clean` merges the
                     previous run's coverage into the report and the removed coverage still shows as
                     covered — the control then reports a FALSE GREEN and proves nothing.

                     The list is deliberately explicit and hand-maintained. Two derived alternatives were
                     considered and rejected: a @RefreshPath marker annotation, which would add a new
                     public production API purely to feed a build gate; and pattern-derived entries such
                     as `..flow.Refresh*` / `..flow.Redeemed*`, which are incomplete — they miss
                     token.RotationResult, token.RefreshTokenFamily, lifecycle.RefreshScheduler and
                     lifecycle.InMemoryTokenStore, all of which are on the refresh path but named and
                     packaged outside that shape. Eleven explicit dotted FQCNs, no wildcards.

                     Why token.TokenErrorResponse is deliberately NOT in the list, even though the
                     credential-rejected classification parses through it: adding it would make "Token"
                     a guarded first camel-word in the token package, and leg (b) of the guard would
                     then demand flow.TokenEndpointClient, token.TokenResponse and
                     lifecycle.TokenLifecycleManager here as well — three large classes pulled under
                     BRANCH >= 0.80 / INSTRUCTION >= 0.90 as a side effect of a four-line DTO. The
                     classification decision the gate cares about lives in flow.RefreshFailureClassification
                     and flow.CredentialRejectedException, both of which ARE listed.

                     A hand-maintained list is only safe because it is guarded.
                     RefreshPathCoverageGuardTest fails the build on BOTH drift directions: (a) an INERT
                     entry — a listed FQCN that binds to no class, i.e. the misspelling case above that
                     jacoco itself reports as a silent green; and (b) a MISSING sibling — a refresh-path
                     class that exists but was never added here. An edit to this block therefore can no
                     longer silently produce a false green.

                     Accepted residual risk: leg (b) demands a class only when its package is one of the
                     guarded packages AND its first camel-case word is one the list already uses. A
                     refresh-path class therefore escapes leg (b) as soon as EITHER condition fails on
                     its own — an unmatched name inside a guarded package escapes just as surely as a
                     matched name outside the guarded packages — and must be added here by hand. Leg (a)
                     is unaffected — it catches every inert entry. -->
                <executions>
                    <execution>
                        <id>refresh-path-coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>de.cuioss.sheriff.token.client.flow.RefreshFlow</include>
                                        <include>de.cuioss.sheriff.token.client.flow.RefreshRedemption</include>
                                        <include>de.cuioss.sheriff.token.client.flow.RefreshFailureClassification</include>
                                        <include>de.cuioss.sheriff.token.client.flow.CredentialRejectedException</include>
                                        <include>de.cuioss.sheriff.token.client.flow.RedeemedResponseException</include>
                                        <include>de.cuioss.sheriff.token.client.flow.RedeemedScopeRefusalException</include>
                                        <include>de.cuioss.sheriff.token.client.flow.RedeemedValidationRefusalException</include>
                                        <include>de.cuioss.sheriff.token.client.token.RotationResult</include>
                                        <include>de.cuioss.sheriff.token.client.token.RefreshTokenFamily</include>
                                        <include>de.cuioss.sheriff.token.client.lifecycle.RefreshScheduler</include>
                                        <include>de.cuioss.sheriff.token.client.lifecycle.InMemoryTokenStore</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
